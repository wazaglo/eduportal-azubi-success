# =============================================================================
# AI-Powered Student Support System - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for local development.
#   cp .env.example .env
# =============================================================================

# ─── AWS Region ──────────────────────────────────────────────────────────────
# AWS_REGION: AWS region where all resources are deployed.
# Default: us-east-1
# Get from: AWS Console > top-right corner region selector
AWS_REGION=us-east-1

# AWS_ENDPOINT: Optional custom endpoint for DynamoDB (use for DynamoDB Local
# during development). Leave empty in production.
# Get from: Not applicable in production; set to http://localhost:8000 for local dev
AWS_ENDPOINT=

# ─── Logging ─────────────────────────────────────────────────────────────────
# LOG_LEVEL: Minimum log level to emit. Values: debug, info, warn, error
# Default: INFO
LOG_LEVEL=INFO

# ─── DynamoDB Table Names ────────────────────────────────────────────────────
# These tables must be created manually in the AWS DynamoDB Console before
# deploying Lambda functions. See docs/aws-resources.md for full schema details.
# Table naming convention: ai-student-{name}
# Get from: AWS Console > DynamoDB > Tables

# TABLE_USERS: Stores student, support, and admin user profiles.
TABLE_USERS=ai-student-users

# TABLE_CONVERSATIONS: Stores chat conversation metadata (title, status, etc.)
TABLE_CONVERSATIONS=ai-student-conversations

# TABLE_MESSAGES: Stores individual chat messages (user + AI responses).
TABLE_MESSAGES=ai-student-messages

# TABLE_CACHE: Caches AI responses to reduce latency and Bedrock costs.
TABLE_CACHE=ai-student-cache

# TABLE_FEEDBACK: Stores user ratings and comments on AI responses.
TABLE_FEEDBACK=ai-student-feedback

# TABLE_ANALYTICS: Stores analytics events for dashboards and reporting.
TABLE_ANALYTICS=ai-student-analytics

# TABLE_AUDIT_LOG: Immutable audit trail for security and compliance.
TABLE_AUDIT_LOG=ai-student-audit-log

# ─── Cognito (Authentication) ────────────────────────────────────────────────
# Create a Cognito User Pool and App Client in AWS Console.
# Get from: AWS Console > Cognito > User Pools > [your pool] > Pool ID
COGNITO_USER_POOL_ID=

# Get from: AWS Console > Cognito > User Pools > [your pool] > App Integration
#            > App client list > Client ID
COGNITO_CLIENT_ID=

# ─── JWT Configuration ───────────────────────────────────────────────────────
# JWT_SECRET: Secret key used to sign JWTs for local/mock auth. In production
# with Cognito, the access/id tokens are used instead of self-signed JWTs, but
# this secret is still needed as a fallback for the JWT issuer configuration.
JWT_SECRET=change-this-to-a-random-secret-in-production

# JWT_ISSUER: The issuer claim (iss) embedded in generated JWTs.
# Default: ai-student-support
JWT_ISSUER=ai-student-support

# ─── Bedrock (AI Configuration) ──────────────────────────────────────────────
# KNOWLEDGE_BASE_ID: Bedrock Knowledge Base ID for RAG-based document retrieval.
# Optional — if empty, knowledge search returns no results.
# Get from: AWS Console > Bedrock > Knowledge Bases > [your KB] > Knowledge Base ID
KNOWLEDGE_BASE_ID=

# BEDROCK_GUARDRAIL_ID: Bedrock Guardrail ID for content filtering.
# Optional — if empty, no guardrails are applied.
# Get from: AWS Console > Bedrock > Guardrails > [your guardrail] > Guardrail ID
BEDROCK_GUARDRAIL_ID=

# BEDROCK_GUARDRAIL_VERSION: Version of the guardrail to use.
# Default: DRAFT
# Get from: AWS Console > Bedrock > Guardrails > [your guardrail] > Versions tab
BEDROCK_GUARDRAIL_VERSION=DRAFT

# AI_PROVIDER: Which AI provider to use.
# Options: bedrock (default), openai, deepseek, gemini
# Note: Only bedrock is fully implemented.
AI_PROVIDER=bedrock

# ─── SES (Email Notifications) ───────────────────────────────────────────────
# SES_FROM_EMAIL: Verified sender email address for sending emails via SES.
# Must be verified in the SES Console or the domain must be verified.
# Get from: AWS Console > SES > Verified identities > Identity name
SES_FROM_EMAIL=noreply@student-support.ai

# ─── SNS (Alerts) ────────────────────────────────────────────────────────────
# SNS_ALERT_TOPIC_ARN: ARN of the SNS topic used for sending system alerts.
# Create an SNS topic and subscribe your email/endpoint to it.
# Get from: AWS Console > SNS > Topics > [your topic] > ARN
SNS_ALERT_TOPIC_ARN=

# ─── SQS (Async Processing) ──────────────────────────────────────────────────
# ASYNC_QUEUE_URL: URL of the SQS FIFO queue used for asynchronous AI response
# processing. When a client sends a message with requireAsync=true, the request
# is enqueued here and processed by the process-async Lambda function.
# Get from: AWS Console > SQS > Queues > [your queue] > URL
ASYNC_QUEUE_URL=

# ─── CORS ────────────────────────────────────────────────────────────────────
# CORS_ORIGIN: Allowed origin for CORS headers. In production, this should be
# the Amplify app URL (e.g., https://app.student-support.ai).
# Default: * (all origins — change in production)
CORS_ORIGIN=*
