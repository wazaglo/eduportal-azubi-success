# =============================================================================
# AI-Powered Student Support System - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for local development.
#   cp .env.example .env
# =============================================================================

# ─── AWS ─────────────────────────────────────────────────────────────────────
# AWS_REGION: region where the backend resources live.
# Default: eu-west-1
AWS_REGION=eu-west-1

# AWS_ENDPOINT: optional custom endpoint for DynamoDB (e.g. DynamoDB Local).
# Leave empty in production.
AWS_ENDPOINT=

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── DynamoDB Table Names ────────────────────────────────────────────────────
TABLE_USERS=ai-student-users
TABLE_QUESTIONS=ai-student-questions
TABLE_CACHE=ai-student-cache
TABLE_ANALYTICS=ai-student-analytics
TABLE_FEEDBACK=ai-student-feedback
TABLE_KNOWLEDGE=ai-student-knowledge

# ─── S3 Knowledge Base ───────────────────────────────────────────────────────
KNOWLEDGE_BUCKET=eduportal-azubi-success-knowledge-base

# ─── Cognito (Authentication) ────────────────────────────────────────────────
COGNITO_USER_POOL_ID=eu-west-1_58jU3t3eE
COGNITO_CLIENT_ID=5u2cc85m997rvttujel00a0ngd

# ─── OpenAI (AI fallback) ────────────────────────────────────────────────────
# AI_PROVIDER: which provider to use. Only `openai` is implemented.
# Default: openai
AI_PROVIDER=openai

# OPENAI_MODEL: model used for answers.
# Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# OPENAI_API_KEY: API key from platform.openai.com. Keep this secret.
# In production this is stored as a GitHub secret and injected by CI/CD.
OPENAI_API_KEY=sk-...

# ─── CORS ────────────────────────────────────────────────────────────────────
# CORS_ORIGIN: allowed origin. In production, the Amplify app URL.
CORS_ORIGIN=*
