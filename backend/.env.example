# ───────────────────────── AWS ─────────────────────────
AWS_REGION=eu-west-1
AWS_ENDPOINT=                               # Optional: local DynamoDB endpoint (e.g. http://localhost:8000)

# ───────────────────────── Cognito ─────────────────────────
COGNITO_USER_POOL_ID=your-cognito-user-pool-id
COGNITO_CLIENT_ID=your-cognito-client-id

# ───────────────────────── DynamoDB Table Names ─────────────────────────
TABLE_USERS=ai-student-users
TABLE_QUESTIONS=ai-student-questions
TABLE_CACHE=ai-student-cache
TABLE_FEEDBACK=ai-student-feedback
TABLE_ANALYTICS=ai-student-analytics
TABLE_KNOWLEDGE=ai-student-knowledge

# ───────────────────────── S3 Knowledge Base ─────────────────────────
KNOWLEDGE_BUCKET=your-knowledge-bucket-name

# ───────────────────────── OpenAI (AI fallback) ─────────────────────────
AI_PROVIDER=openai                         # only `openai` is implemented
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...                      # keep secret

# ───────────────────────── CORS ─────────────────────────
CORS_ORIGIN=*
