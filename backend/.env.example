# ───────────────────────── AWS ─────────────────────────
AWS_REGION=eu-west-1
AWS_ENDPOINT=                               # Optional: local DynamoDB endpoint (e.g. http://localhost:8000)

# ───────────────────────── Cognito ─────────────────────────
COGNITO_USER_POOL_ID=your-cognito-user-pool-id
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_CLIENT_SECRET=your-cognito-client-secret   # Required for SECRET_HASH in admin operations

# ───────────────────────── DynamoDB Table Names ─────────────────────────
TABLE_USERS=ai-student-users
TABLE_CONVERSATIONS=ai-student-conversations
TABLE_MESSAGES=ai-student-messages
TABLE_CACHE=ai-student-cache
TABLE_FEEDBACK=ai-student-feedback
TABLE_ANALYTICS=ai-student-analytics
TABLE_AUDIT_LOG=ai-student-audit-log

# ───────────────────────── JWT ─────────────────────────
JWT_SECRET=your-jwt-secret-key
JWT_ISSUER=azubi-success

# ───────────────────────── S3 Knowledge Base ─────────────────────────
KNOWLEDGE_BUCKET=your-knowledge-bucket-name    # S3 bucket with knowledge/{level}/ prefix structure

# ───────────────────────── SQS (Async Processing) ─────────────────────────
ASYNC_QUEUE_URL=your-sqs-queue-url             # FIFO queue for async message processing

# ───────────────────────── AI Model (set later by another team) ─────────────────────────
AI_PROVIDER=bedrock                            # bedrock | openai | deepseek | gemini
AI_MODEL_ID=eu.amazon.nova-lite-v1:0           # Model ID / inference profile ARN
BEDROCK_GUARDRAIL_ID=                          # Optional: Bedrock guardrail ID
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ───────────────────────── CORS ─────────────────────────
CORS_ORIGIN=*
