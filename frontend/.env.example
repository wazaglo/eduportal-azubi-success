# =============================================================================
# AI-Powered Student Support System - Frontend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# All public env vars must be prefixed with PUBLIC_ for Vite/Qwik to expose
# them to the client-side code.
# =============================================================================

# Backend API URL (API Gateway endpoint in production)
# After deploying the backend, set this to the API Gateway invoke URL:
# https://<api-id>.execute-api.<region>.amazonaws.com/<stage>
PUBLIC_API_URL=http://localhost:3000/api

# Application
PUBLIC_APP_NAME=StudentAI